# Server Configuration
PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgres://user:password@localhost:5432/golang_skeleton?sslmode=disable
DATABASE_MAX_CONN=25
DATABASE_MAX_IDLE=5

# Redis (Optional)
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Rate Limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20